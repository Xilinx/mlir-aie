// RUN: %aiecc -n --no-progress --tmpdir %t.retry --placer=sa_placer --get=input_with_symbols.mlir %S/Inputs/placement_retry_walked.mlir 2>&1 | FileCheck %s --check-prefix=RETRY
// RUN: not %aiecc -n --no-progress --tmpdir %t.pinned --placer=sa_placer --sa-walked-fifos=main:c --get=input_with_symbols.mlir %S/Inputs/placement_retry_walked.mlir 2>&1 | FileCheck %s --check-prefix=PINNED
// RUN: not %aiecc -n --no-progress --tmpdir %t.never --placer=sa_placer --get=input_with_symbols.mlir %s 2>&1 | FileCheck %s --check-prefix=NEVER
// RUN: %aiecc -n --no-progress --tmpdir %t.otherpin --placer=sa_placer --sa-core-data-sizes=main:0=0 --get=input_with_symbols.mlir %S/Inputs/placement_retry_walked.mlir 2>&1 | FileCheck %s --check-prefix=OTHERPIN

// The core takes a and b in turn from mem tile pools of 7 and 6 objects, so
// allocation walks both pools whole, one buffer each. The SA placer counts
// their objects apart, which fit the holes of the mem tile next to the core;
// the walked buffers do not. aiecc places again with the pool allocation
// names counted walked, and that placement allocates.
// RETRY: aiecc: objectFIFO @a_in of @main's buffers find no room; placing again with --sa-walked-fifos=main:a_in
// RETRY-NOT: error:

// Core data sizes the command line chose leave this retry on.
// OTHERPIN: aiecc: objectFIFO @a_in of @main's buffers find no room; placing again with --sa-walked-fifos=main:a_in
// OTHERPIN-NOT: error:

// Walked pools the command line chose are kept.
// PINNED: error: 'aie.objectfifo.pool' op could not place buffers in accessible memory with available capacity for objectFIFO @main::@a_in
// PINNED-NOT: placing again

// The one mem tile has no room for the walked buffers wherever it goes;
// aiecc reports the first placement's error and its failed edge.
// NEVER: aiecc: objectFIFO @a_in of @main's buffers find no room; placing again with --sa-walked-fifos=main:a_in
// NEVER-NOT: placing again
// NEVER: error: 'aie.objectfifo.pool' op could not place buffers in accessible memory with available capacity for objectFIFO @main::@a_in
// NEVER: aiecc: no placement with what allocation found counted fits either; the errors above are the first placement's
// NEVER: aiecc: edge 'input_with_symbols.mlir' (key '{{.*}}') failed

module @turn_walk_never {
  aie.device(npu2_1col) {
    %s = aie.logical_tile<ShimNOCTile>(0, 0)
    %u = aie.logical_tile<CoreTile>(0, 4)
    %m = aie.logical_tile<MemTile>(?, ?)
    %t = aie.logical_tile<CoreTile>(0, 2)
    %h0 = aie.buffer(%m) {address = 1024 : i32, sym_name = "hold0"} : memref<256xi32>
    %r0 = aie.buffer(%m) {address = 3072 : i32, sym_name = "rest0"} : memref<130304xi32>
    aie.objectfifo @a_in(%s, {%m}, [2 : i32, 7 : i32]) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo @a(%m, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo.link [@a_in] -> [@a] ([] [])
    aie.objectfifo @b_in(%s, {%m}, [2 : i32, 6 : i32]) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo @b(%m, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo.link [@b_in] -> [@b] ([] [])
    aie.objectfifo @c(%u, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.core(%u) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c42 = arith.constant 42 : index
      scf.for %i = %c0 to %c42 step %c1 {
        %y = aie.objectfifo.acquire @c(Produce, 1) : memref<64xi32>
        aie.objectfifo.release @c(Produce, 1)
      }
      aie.end
    }
    aie.core(%t) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c42 = arith.constant 42 : index
      scf.for %i = %c0 to %c42 step %c1 {
        %x = aie.objectfifo.acquire @c(Consume, 1) : memref<64xi32>
        %a0 = aie.objectfifo.acquire @a(Consume, 1) : memref<64xi32>
        aie.objectfifo.release @a(Consume, 1)
        %bb = aie.objectfifo.acquire @b(Consume, 1) : memref<64xi32>
        aie.objectfifo.release @b(Consume, 1)
        aie.objectfifo.release @c(Consume, 1)
      }
      aie.end
    }
  }
}
