// REQUIRES: peano
// RUN: %aiecc -j1 --verbose --no-progress --tmpdir %t.seq --get=input_with_addresses.mlir %s 2>&1 | FileCheck %s
// RUN: %aiecc -j1 --verbose --no-progress --tmpdir %t.sa --placer=sa_placer --get=input_with_addresses.mlir %s 2>&1 | FileCheck %s

// aiecc might place again until the placement's edges pass, and prints as
// it goes all the same: the warning from lowering the objectFIFOs comes
// before that edge's own line, then the tools' lines and the edges after it,
// as in a build that cannot place again.
// CHECK: ) traced.mlir (1 inputs) took
// CHECK-NEXT: warning: func 'never_called' has link_with but is never called from any core
// CHECK: ) input_with_symbols.mlir (1 inputs) took
// CHECK: aiecc: exec: {{.*}}opt
// CHECK: ) input_with_addresses.mlir ({{[0-9]+}} inputs) took
// CHECK-NOT: warning:


module @hold_order {
  aie.device(npu2) {
    func.func private @never_called(memref<16xi32>) attributes {link_with = "never_called.o"}
    %shim = aie.logical_tile<ShimNOCTile>(7, 0)
    %p = aie.logical_tile<CoreTile>(0, 2)
    %c = aie.logical_tile<CoreTile>(?, ?)
    memref.global "private" @scratch : memref<64xi32> = uninitialized
    aie.objectfifo @x(%p, {%c}, 2 : i32) : !aie.objectfifo<memref<4096xi32>>
    aie.objectfifo @y(%c, {%shim}, 2 : i32) : !aie.objectfifo<memref<1024xi32>>
    aie.objectfifo @z(%c, {%shim}, 2 : i32) : !aie.objectfifo<memref<1024xi32>>
    aie.core(%p) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %cmax = arith.constant 9223372036854775807 : index
      scf.for %i = %c0 to %cmax step %c1 {
        %o = aie.objectfifo.acquire @x(Produce, 1) : memref<4096xi32>
        %v = arith.index_cast %i : index to i32
        memref.store %v, %o[%c0] : memref<4096xi32>
        aie.objectfifo.release @x(Produce, 1)
      }
      aie.end
    }
    aie.core(%c) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %cmax = arith.constant 9223372036854775807 : index
      %n = arith.constant 64 : index
      %g = memref.get_global @scratch : memref<64xi32>
      scf.for %i = %c0 to %cmax step %c1 {
        %ix = aie.objectfifo.acquire @x(Consume, 1) : memref<4096xi32>
        %oy = aie.objectfifo.acquire @y(Produce, 1) : memref<1024xi32>
        %oz = aie.objectfifo.acquire @z(Produce, 1) : memref<1024xi32>
        %v = memref.load %ix[%c0] : memref<4096xi32>
        %vi = arith.index_cast %v : i32 to index
        %k = arith.remui %vi, %n : index
        %old = memref.load %g[%k] : memref<64xi32>
        memref.store %v, %g[%k] : memref<64xi32>
        memref.store %old, %oy[%c0] : memref<1024xi32>
        memref.store %v, %oz[%c0] : memref<1024xi32>
        aie.objectfifo.release @x(Consume, 1)
        aie.objectfifo.release @y(Produce, 1)
        aie.objectfifo.release @z(Produce, 1)
      }
      aie.end
    }
  }
}
