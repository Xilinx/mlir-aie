// RUN: not %aiecc -n --no-progress --tmpdir %t --placer=sa_placer --get=input_with_symbols.mlir %s 2>&1 | FileCheck %s

// @d0 is placement_retry_walked's design, which placing again with its walked
// pools charged fixes; @d1 is placement_retry_unwalked's, whose allocation
// fails before channel turns walk anything, in every placement. Placement 2
// fixes @d0 and fails on @d1 alone, which charging cannot address: that
// failure is placement 2's own, and it stands.
// CHECK: note: channel turns walked these objectFIFOs' mem tile pools whole: @d0::@b_in, @d0::@a_in
// CHECK: aiecc: placing again with --sa-walked-fifos=@d0::@a_in,@d0::@b_in (buffers channel turns walked whole found no room); the messages above are from placement 1
// CHECK: error: 'aie.objectfifo.pool' op could not place buffers in accessible memory with available capacity for objectFIFO @d1::@a_in
// CHECK-NOT: channel turns walked
// CHECK-NOT: no placement
// CHECK: aiecc: placement 2 (--sa-walked-fifos=@d0::@a_in,@d0::@b_in) stands
// CHECK: aiecc: edge 'input_with_symbols.mlir' (key '{{.*}}') failed

module @walked_then_unrelated {
  aie.device(npu2) @d0 {
    %s = aie.logical_tile<ShimNOCTile>(0, 0)
    %s1 = aie.logical_tile<ShimNOCTile>(1, 0)
    %b0 = aie.logical_tile<MemTile>(0, 1)
    %b1 = aie.logical_tile<MemTile>(1, 1)
    %m = aie.logical_tile<MemTile>(?, ?)
    %t = aie.logical_tile<CoreTile>(0, 2)
    %h0 = aie.buffer(%b0) {address = 1024 : i32, sym_name = "hold0"} : memref<256xi32>
    %r0 = aie.buffer(%b0) {address = 3072 : i32, sym_name = "rest0"} : memref<130304xi32>
    %h1 = aie.buffer(%b1) {address = 1024 : i32, sym_name = "hold1"} : memref<256xi32>
    %r1 = aie.buffer(%b1) {address = 3072 : i32, sym_name = "rest1"} : memref<130304xi32>
    aie.objectfifo @a_in(%s, {%m}, [2 : i32, 7 : i32]) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo @a(%m, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo.link [@a_in] -> [@a] ([] [])
    aie.objectfifo @b_in(%s, {%m}, [2 : i32, 6 : i32]) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo @b(%m, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo.link [@b_in] -> [@b] ([] [])
    aie.objectfifo @c(%s1, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.core(%t) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c42 = arith.constant 42 : index
      scf.for %i = %c0 to %c42 step %c1 {
        %x = aie.objectfifo.acquire @c(Consume, 1) : memref<64xi32>
        %a0 = aie.objectfifo.acquire @a(Consume, 1) : memref<64xi32>
        aie.objectfifo.release @a(Consume, 1)
        %bb = aie.objectfifo.acquire @b(Consume, 1) : memref<64xi32>
        aie.objectfifo.release @b(Consume, 1)
        aie.objectfifo.release @c(Consume, 1)
      }
      aie.end
    }
  }
  aie.device(npu2_1col) @d1 {
    %s = aie.logical_tile<ShimNOCTile>(0, 0)
    %u = aie.logical_tile<CoreTile>(0, 4)
    %m = aie.logical_tile<MemTile>(?, ?)
    %t = aie.logical_tile<CoreTile>(0, 2)
    %h0 = aie.buffer(%m) {address = 1024 : i32, sym_name = "hold0"} : memref<256xi32>
    %r0 = aie.buffer(%m) {address = 3072 : i32, sym_name = "rest0"} : memref<130304xi32>
    aie.objectfifo @a_in(%s, {%m}, [2 : i32, 7 : i32]) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo @a(%m, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo.link [@a_in] -> [@a] ([] [])
    aie.objectfifo @b_in(%s, {%m}, [2 : i32, 6 : i32]) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo @b(%m, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.objectfifo.link [@b_in] -> [@b] ([] [])
    aie.objectfifo @c(%u, {%t}, 2 : i32) : !aie.objectfifo<memref<64xi32>>
    aie.core(%u) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c42 = arith.constant 42 : index
      scf.for %i = %c0 to %c42 step %c1 {
        %y = aie.objectfifo.acquire @c(Produce, 1) : memref<64xi32>
        aie.objectfifo.release @c(Produce, 1)
      }
      aie.end
    }
    aie.core(%t) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c42 = arith.constant 42 : index
      scf.for %i = %c0 to %c42 step %c1 {
        %x = aie.objectfifo.acquire @c(Consume, 1) : memref<64xi32>
        %a0 = aie.objectfifo.acquire @a(Consume, 1) : memref<64xi32>
        aie.objectfifo.release @a(Consume, 1)
        %bb = aie.objectfifo.acquire @b(Consume, 1) : memref<64xi32>
        aie.objectfifo.release @b(Consume, 1)
        aie.objectfifo.release @c(Consume, 1)
      }
      aie.end
    }
  }
}
