// The compiler-rt frames aiecc falls back on match the installed Peano. If a
// Peano bump changes them, regenerate the table:
//   python utils/generate_compiler_rt_stack_frames.py > tools/aiecc/CompilerRtStackFrames.inc

// REQUIRES: peano
// RUN: %PYTHON %S/../../utils/generate_compiler_rt_stack_frames.py > %t.inc
// RUN: diff %S/../../tools/aiecc/CompilerRtStackFrames.inc %t.inc
