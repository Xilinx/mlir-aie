// REQUIRES: peano

// Compile and link a real multi-bank frame, not just an unused reservation.
// RUN: rm -rf %t.d && mkdir -p %t.d
// RUN: clang++ --target=aie2-none-unknown-elf -O2 -ffunction-sections -fdata-sections -fstack-size-section -mllvm -print-all-options -c %S/large_stack_kernel.cc -o %t.d/large_stack_kernel.o 2>&1 | FileCheck %s --check-prefix=OPTIONS
// RUN: cd %t.d && aiecc --get-core-elfs --get=measured_stack_sizes.mlir --output-dir=%t.out --tmpdir=%t.prj -v %S/large_stack.mlir 2>&1 | FileCheck %s --check-prefix=COMPILE --implicit-check-not="aie-stack-addrspace"

// Peano's default 0 is unrestricted. Values 5-8 promise a single bank and
// are unsafe for this stack; neither the kernel nor aiecc may assume one.
// OPTIONS: --aie-stack-addrspace = 0
// COMPILE: llc {{.*}}--march=aie2
// COMPILE-SAME: -stack-size-section
// COMPILE: clang {{.*}}--target=aie2-none-unknown-elf
// COMPILE-SAME: -Wl,--gc-sections

// A one-bank reservation must fail, proving the frame wasn't optimized away.
// RUN: sed 's/stack_size = 20480/stack_size = 16384/' %S/large_stack.mlir > %t.d/small.mlir
// RUN: cd %t.d && not aiecc --get=measured_stack_sizes.mlir --output-dir=%t.small --tmpdir=%t.small.prj small.mlir 2>&1 | FileCheck %s --check-prefix=SMALL
// SMALL: error: stack_size = 16384 is insufficient: this core needs {{[0-9]+}} bytes

// With stack_size absent, aiecc sizes the stack past bank A. The core's own
// frames still fit in bank A, so its object keeps the bank claim; the kernel,
// compiled separately, never had one.
// RUN: sed 's/ {stack_size = 20480 : i32}//' %S/large_stack.mlir > %t.d/absent.mlir
// RUN: cd %t.d && aiecc --get=input_with_addresses.mlir --output-dir=%t.absent --tmpdir=%t.absent.prj -v absent.mlir 2>&1 | FileCheck %s --check-prefix=ABSENT
// RUN: FileCheck %s --check-prefix=ABSENT-PLACED < %t.absent/input_with_addresses.mlir
// ABSENT: llc {{.*}}-aie-stack-addrspace=5
// ABSENT-PLACED: aie.buffer(%{{.*}}) {address = {{1[89][0-9][0-9][0-9]}} : i32
// ABSENT-PLACED: measured_stack_size = {{1[89][0-9][0-9][0-9]}} : i32

// stack_bank holds the stack to one bank, which the measured stack outgrows.
// RUN: sed 's/ {stack_size = 20480 : i32}/ {stack_bank = 0 : i32}/' %S/large_stack.mlir > %t.d/banked.mlir
// RUN: cd %t.d && not aiecc --output-dir=%t.banked --tmpdir=%t.banked.prj banked.mlir 2>&1 | FileCheck %s --check-prefix=BANKED
// BANKED: error: this core needs a {{1[89][0-9][0-9][0-9]}}-byte stack, but stack_bank pins it to memory bank A, which holds 16384 bytes. Omit stack_bank and stack_address

// A bare build writes the core ELFs, not the module the checks ran on.
// RUN: rm -rf %t.bare && mkdir -p %t.bare && cp %t.d/large_stack_kernel.o %t.bare
// RUN: cd %t.bare && not aiecc --tmpdir=%t.bare.small.prj %t.d/small.mlir 2>&1 | FileCheck %s --check-prefix=SMALL
// RUN: cd %t.bare && aiecc --tmpdir=%t.bare.prj %S/large_stack.mlir
// RUN: ls %t.bare | FileCheck %s --check-prefix=BARE --implicit-check-not=.mlir
// BARE: elfs_main_core_0_2

// A resume runs the checks the cut left out; a --get resume runs only what it
// names, so it needs neither the checks nor the input module.
// RUN: rm -rf %t.res && mkdir -p %t.res && cp %t.d/large_stack_kernel.o %t.d/small.mlir %t.res
// RUN: cd %t.res && aiecc --get-core-elfs --tmpdir=%t.res.prj --cut='elfs_{0}.elf' --checkpoint=%t.res.ckpt small.mlir
// RUN: cd %t.res && not aiecc --resume=%t.res.ckpt/manifest.json 2>&1 | FileCheck %s --check-prefix=SMALL
// RUN: rm %t.res/small.mlir
// RUN: cd %t.res && aiecc --resume=%t.res.ckpt/manifest.json '--get=elfs_{0}.elf'

// DOT keeps the post-link check reachable without marking it as an output.
// RUN: aiecc --get-core-elfs --emit-dot | FileCheck %s --check-prefix=DOT
// DOT: [label="checked_bank_placement.mlir"];
