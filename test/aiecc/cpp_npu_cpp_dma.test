// Drive genuinely dynamic DMA sizes through aiecc, not a separately assembled
// lowering pipeline. The static builder must match --get-npu-insts byte for
// byte; the dynamic builder must program the same registers (its BD writes can
// have a different encoding). Reuse the target's existing replay comparator.
// RUN: rm -rf %t.d && mkdir -p %t.d
// RUN: aiecc --get-npu-cpp --output-dir=%t.d --tmpdir=%t.d/work %S/../Targets/NPU/static_vs_dynamic/memcpy_nd_dynamic_size.mlir
// RUN: aiecc --get-npu-insts --sequence-name=nd_static --output-dir=%t.d --tmpdir=%t.d/static %S/../Targets/NPU/static_vs_dynamic/memcpy_nd_dynamic_size.mlir
// RUN: %PYTHON -c "import pathlib,struct; b=pathlib.Path('%t.d/insts_main_nd_static.bin').read_bytes(); pathlib.Path('%t.d/golden.hex').write_text(''.join('%08X\n'%w for (w,) in struct.iter_unpack('<I',b)))"
// RUN: %host_clang -std=c++17 -I%S/../../include -include %t.d/npu_main_nd_dynamic.cpp -DGEN_HDR='"%t.d/npu_main_nd_static.cpp"' -DSTATIC_FN=generate_txn_main_nd_static -DDYN_FN=generate_txn_main_nd_dynamic -DARGVAL=4 -DDYN_STRUCTURAL %S/../Targets/NPU/static_vs_dynamic/Inputs/compare_main.cpp %host_link_flags -o %t.d/compare
// RUN: %t.d/compare %t.d/golden.hex
// RUN: %host_clang -std=c++17 -I%S/../../include -DGEN_HDR='"%t.d/npu_main_nd_dynamic.cpp"' -DGEN_FN=generate_txn_main_nd_dynamic -DSCALAR %S/Inputs/npu_cpp_dump.cpp %host_link_flags -o %t.d/native
// RUN: %t.d/native %t.d/valid.bin 4
// RUN: %t.d/native %t.d/larger.bin 8
// RUN: not cmp %t.d/valid.bin %t.d/larger.bin

// The hardware tests' dynamic sources also compile and build transactions on
// the host alone: rolled loops, iter_arg awaits, nested conditionals, tracing,
// and the out-of-order shim receive path all use the same driver edge.
// RUN: aiecc --get-npu-cpp --output-dir=%t.d/pingpong --tmpdir=%t.d/pingpong/work %S/../npu-xrt/dynamic_pingpong_passthrough/aie.mlir
// RUN: %host_clang -std=c++17 -I%S/../../include -DGEN_HDR='"%t.d/pingpong/npu_main_sequence.cpp"' -DGEN_FN=generate_txn_main_sequence -DSCALAR %S/Inputs/npu_cpp_dump.cpp %host_link_flags -o %t.d/pingpong/native
// RUN: %t.d/pingpong/native %t.d/pingpong/two.bin 2 && %t.d/pingpong/native %t.d/pingpong/eight.bin 8
// RUN: not cmp %t.d/pingpong/two.bin %t.d/pingpong/eight.bin
// RUN: aiecc --get-npu-cpp --output-dir=%t.d/iterarg --tmpdir=%t.d/iterarg/work %S/../npu-xrt/dynamic_pingpong_iterarg_await/aie.mlir
// RUN: %host_clang -std=c++17 -I%S/../../include -DGEN_HDR='"%t.d/iterarg/npu_main_sequence.cpp"' -DGEN_FN=generate_txn_main_sequence -DSCALAR %S/Inputs/npu_cpp_dump.cpp %host_link_flags -o %t.d/iterarg/native
// RUN: %t.d/iterarg/native %t.d/iterarg/two.bin 2 && %t.d/iterarg/native %t.d/iterarg/eight.bin 8
// RUN: not cmp %t.d/iterarg/two.bin %t.d/iterarg/eight.bin
// RUN: aiecc --get-npu-cpp --output-dir=%t.d/conditional --tmpdir=%t.d/conditional/work %S/../npu-xrt/dynamic_conditional_passthrough/aie.mlir
// RUN: %host_clang -std=c++17 -I%S/../../include -DGEN_HDR='"%t.d/conditional/npu_main_sequence.cpp"' -DGEN_FN=generate_txn_main_sequence -DCONDITIONAL %S/Inputs/npu_cpp_dump.cpp %host_link_flags -o %t.d/conditional/native
// RUN: %t.d/conditional/native %t.d/conditional/false.bin 2 0 && %t.d/conditional/native %t.d/conditional/true.bin 2 1
// RUN: %PYTHON -c "import pathlib; assert pathlib.Path('%t.d/conditional/false.bin').stat().st_size == 16; assert pathlib.Path('%t.d/conditional/true.bin').stat().st_size > 16"
// RUN: aiecc --get-npu-cpp --output-dir=%t.d/trace --tmpdir=%t.d/trace/work %S/../npu-xrt/dynamic_pingpong_trace/aie.mlir
// RUN: %host_clang -std=c++17 -I%S/../../include -DGEN_HDR='"%t.d/trace/npu_main_sequence.cpp"' -DGEN_FN=generate_txn_main_sequence -DSCALAR %S/Inputs/npu_cpp_dump.cpp %host_link_flags -o %t.d/trace/native
// RUN: %t.d/trace/native %t.d/trace/two.bin 2 && %t.d/trace/native %t.d/trace/eight.bin 8
// RUN: not cmp %t.d/trace/two.bin %t.d/trace/eight.bin
// RUN: aiecc --get-npu-cpp --output-dir=%t.d/ooo --tmpdir=%t.d/ooo/work %S/../npu-xrt/dma_s2mm_ooo_shim_recv/aie.mlir
// RUN: %host_clang -std=c++17 -I%S/../../include -DGEN_HDR='"%t.d/ooo/npu_main_sequence.cpp"' -DGEN_FN=generate_txn_main_sequence %S/Inputs/npu_cpp_dump.cpp %host_link_flags -o %t.d/ooo/native
// RUN: %t.d/ooo/native %t.d/ooo/insts.bin
