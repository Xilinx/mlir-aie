# REQUIRES: system-linux
# RUN: bash -c '%host_clang $(%LLVM_TOOLS_DIR/llvm-config --cxxflags) -std=c++17 -UNDEBUG -I%S/../../tools/aiecc -I%S/../../include %S/split_ir_sharing.cpp $(%LLVM_TOOLS_DIR/llvm-config --ldflags) -Wl,--start-group -lMLIRParser -lMLIRAsmParser -lMLIRBytecodeReader -lMLIRBytecodeWriter -lMLIRFuncDialect -lMLIRCallInterfaces -lMLIRControlFlowInterfaces -lMLIRFunctionInterfaces -lMLIRInferTypeOpInterface -lMLIRSideEffectInterfaces -lMLIRIR -lMLIRSupport $(%LLVM_TOOLS_DIR/llvm-config --libs support --system-libs) -Wl,--end-group %host_link_flags -o %t.exe'
# RUN: rm -rf %t.ckpt
# RUN: %t.exe %t.ckpt | FileCheck %s
# RUN: FileCheck %s --check-prefix=IR --input-file=%t.ckpt/module.mlir

# CHECK: split sharing: all checks passed
# IR: module @device_a
# IR: func.func private @seq_a() attributes {test.target = @device_b::@seq_c}
# IR: func.func private @seq_b()
# IR: module @device_b
# IR: func.func private @seq_c()
