// REQUIRES: peano
// RUN: rm -rf %t.d && mkdir -p %t.d
// RUN: aiecc --get-full-elf --get-elf --get-xclbin --full-elf-name=full.elf --elf-name=partial.elf --xclbin-name=design.xclbin --get=full.elf.unstamped --get=partial.elf.unstamped --output-dir=%t.d --tmpdir=%t.d/work %S/cpp_full_elf_generation.mlir
// RUN: %python %S/Inputs/provenance_checks.py compare %t.d/full.elf.unstamped %t.d/full.elf
// RUN: %python %S/Inputs/provenance_checks.py compare %t.d/partial.elf.unstamped %t.d/partial.elf
// RUN: xclbinutil --input %t.d/design.xclbin --dump-section KEYVALUE_METADATA:JSON:%t.d/metadata.json
// RUN: %python %S/Inputs/provenance_checks.py xclbin %t.d/full.elf %t.d/metadata.json
// RUN: xclbinutil --input %t.d/design.xclbin --key-value USER:unrelated:keep --key-value USER:mlir_aie.provenance:outdated --output %t.d/seed.xclbin
// RUN: sed 's/constant 1 : i32/constant 2 : i32/' %S/cpp_full_elf_generation.mlir > %t.d/second.mlir
// RUN: aiecc --get-xclbin --xclbin-input=%t.d/seed.xclbin --xclbin-kernel-name=second --xclbin-instance-name=second --xclbin-kernel-id=0x902 --xclbin-name=extended.xclbin --output-dir=%t.d/extension --tmpdir=%t.d/extension/work %t.d/second.mlir
// RUN: xclbinutil --input %t.d/extension/extended.xclbin --dump-section KEYVALUE_METADATA:JSON:%t.d/extended.json
// RUN: %python %S/Inputs/provenance_checks.py xclbin %t.d/full.elf %t.d/extended.json keep
// RUN: xclbinutil --input %t.d/design.xclbin --remove-section KEYVALUE_METADATA --output %t.d/bare.xclbin
// RUN: aiecc --get-xclbin --xclbin-input=%t.d/bare.xclbin --xclbin-kernel-name=second --xclbin-instance-name=second --xclbin-kernel-id=0x902 --xclbin-name=extended.xclbin --output-dir=%t.d/bare-extension --tmpdir=%t.d/bare-extension/work %t.d/second.mlir
// RUN: xclbinutil --input %t.d/bare-extension/extended.xclbin --dump-section KEYVALUE_METADATA:JSON:%t.d/bare-extended.json
// RUN: %python %S/Inputs/provenance_checks.py xclbin %t.d/full.elf %t.d/bare-extended.json
// RUN: aie-opt -aie-generate-column-control-overlay="route-shim-to-tile-ctrl=true" %S/cpp_ctrlpkt.mlir -o %t.d/ctrl.mlir
// RUN: aiecc --get-ctrlpkt --ctrlpkt-elf-name=ctrl.elf --get=ctrl.elf.unstamped --output-dir=%t.d/ctrl --tmpdir=%t.d/ctrl/work %t.d/ctrl.mlir
// RUN: %python %S/Inputs/provenance_checks.py compare %t.d/ctrl/ctrl.elf.unstamped %t.d/ctrl/ctrl.elf
