      aie.connect<West : 0, South : 3>
      aie.connect<West : 0, North : 1>
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.masterset(South : 0, %0)
      %3 = aie.masterset(South : 1, %1)
      aie.packet_rules(North : 1) {
        aie.rule(31, 22, %1)
      }
      aie.packet_rules(North : 0) {
        aie.rule(31, 11, %0)
      }
    }
    %switchbox_2_3 = aie.switchbox(%tile_2_3) {
      aie.connect<South : 1, DMA : 0>
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.amsel<0> (1)
      %3 = aie.masterset(DMA : 1, %0, %2)
      %4 = aie.masterset(South : 0, %1)
      %5 = aie.masterset(South : 1, %2)
      %6 = aie.masterset(North : 4, %2)
      aie.packet_rules(West : 3) {
        aie.rule(31, 22, %2)
      }
      aie.packet_rules(West : 2) {
        aie.rule(31, 28, %0)
      }
      aie.packet_rules(North : 2) {
        aie.rule(31, 11, %1)
      }
    }
    %switchbox_1_4 = aie.switchbox(%tile_1_4) {
      %0 = aie.amsel<0> (0)
      %1 = aie.masterset(North : 2, %0)
      aie.packet_rules(South : 0) {
        aie.rule(31, 11, %0)
      }
    }
    %switchbox_2_4 = aie.switchbox(%tile_2_4) {
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.masterset(South : 2, %1)
      %3 = aie.masterset(North : 5, %0)
      aie.packet_rules(South : 4) {
        aie.rule(31, 22, %0)
      }
      aie.packet_rules(North : 3) {
        aie.rule(31, 11, %1)
      }
    }
  }
}
