      aiex.npu.dma_memcpy_nd(%out[0, 0, 0, 0][1, 1, 1, 5632][0, 0, 0, 1]) { metadata = @out4_1, id = 0 : i64, issue_token = true } : memref<8192xi32>
      aiex.npu.dma_wait {symbol = @out4_1}
      aiex.npu.dma_wait {symbol = @in5_1}
      aiex.npu.dma_wait {symbol = @out5_1}
    }
  }
}

