      }
      aie.packet_rules(East : 3) {
        aie.rule(29, 17, %1)
      }
    }
    %switchbox_5_3 = aie.switchbox(%tile_5_3) {
      aie.connect<West : 1, DMA : 0>
      aie.connect<North : 1, South : 1>
      aie.connect<West : 2, North : 1>
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.amsel<2> (0)
      %3 = aie.masterset(West : 0, %2)
      %4 = aie.masterset(West : 3, %1)
      %5 = aie.masterset(North : 0, %0)
      aie.packet_rules(South : 3) {
        aie.rule(30, 30, %0)
      }
      aie.packet_rules(DMA : 0) {
        aie.rule(30, 30, %0)
      }
      aie.packet_rules(South : 5) {
        aie.rule(31, 17, %2)
      }
      aie.packet_rules(South : 2) {
        aie.rule(29, 17, %1)
      }
    }
    %switchbox_5_2 = aie.switchbox(%tile_5_2) {
      aie.connect<North : 1, West : 0>
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.amsel<2> (0)
      %3 = aie.masterset(North : 2, %2)
      %4 = aie.masterset(North : 3, %1)
      %5 = aie.masterset(North : 5, %0)
      aie.packet_rules(South : 1) {
        aie.rule(30, 30, %1)
      }
      aie.packet_rules(DMA : 1) {
        aie.rule(31, 17, %0)
      }
      aie.packet_rules(South : 4) {
        aie.rule(29, 17, %2)
      }
    }
    %switchbox_5_4 = aie.switchbox(%tile_5_4) {
      aie.connect<DMA : 0, South : 1>
      aie.connect<South : 1, North : 1>
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<0> (1)
      %2 = aie.masterset(DMA : 1, %0, %1)
      %3 = aie.masterset(West : 3, %0)
      aie.packet_rules(DMA : 1) {
