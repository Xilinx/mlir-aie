module {
  aie.device(npu2) {
    %shim_noc_tile_4_0 = aie.tile(4, 0)
    %mem_tile_4_1 = aie.tile(4, 1)
    %tile_4_2 = aie.tile(4, 2)
    %tile_4_3 = aie.tile(4, 3)
    %tile_4_4 = aie.tile(4, 4)
    %tile_4_5 = aie.tile(4, 5)
    %shim_noc_tile_5_0 = aie.tile(5, 0)
    %mem_tile_5_1 = aie.tile(5, 1)
    %tile_5_2 = aie.tile(5, 2)
    %tile_5_3 = aie.tile(5, 3)
    %tile_5_4 = aie.tile(5, 4)
    %tile_5_5 = aie.tile(5, 5)
    %shim_mux_4_0 = aie.shim_mux(%shim_noc_tile_4_0) {
      aie.connect<North : 3, DMA : 1>
    }
    %switchbox_4_0 = aie.switchbox(%shim_noc_tile_4_0) {
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.masterset(South : 3, %0)
      %3 = aie.masterset(East : 0, %1)
      aie.packet_rules(North : 1) {
        aie.rule(31, 10, %0)
      }
      aie.packet_rules(North : 0) {
        aie.rule(31, 11, %0)
      }
      aie.packet_rules(North : 3) {
        aie.rule(31, 9, %1)
      }
    }
    %switchbox_4_4 = aie.switchbox(%tile_4_4) {
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.amsel<2> (0)
      %3 = aie.amsel<3> (0)
      %4 = aie.amsel<4> (0)
      %5 = aie.amsel<2> (1)
      %6 = aie.masterset(South : 0, %2, %5)
      %7 = aie.masterset(South : 1, %4)
      %8 = aie.masterset(South : 3, %3)
      %9 = aie.masterset(North : 4, %0)
      %10 = aie.masterset(North : 5, %1)
      %11 = aie.masterset(East : 3, %2)
      aie.packet_rules(DMA : 1) {
        aie.rule(31, 10, %2)
      }
      aie.packet_rules(East : 3) {
        aie.rule(31, 10, %5)
      }
      aie.packet_rules(North : 0) {
        aie.rule(31, 11, %3)
      }
      aie.packet_rules(North : 3) {
        aie.rule(31, 9, %4)
      }
      aie.packet_rules(South : 5) {
        aie.rule(31, 17, %1)
      }
      aie.packet_rules(South : 4) {
        aie.rule(29, 17, %0)
      }
    }
    %switchbox_4_5 = aie.switchbox(%tile_4_5) {
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.amsel<2> (0)
      %3 = aie.amsel<3> (0)
      %4 = aie.masterset(DMA : 0, %0)
      %5 = aie.masterset(DMA : 1, %1) {keep_pkt_header = true}
      %6 = aie.masterset(South : 0, %3)
      %7 = aie.masterset(South : 3, %2)
      aie.packet_rules(DMA : 1) {
        aie.rule(31, 11, %3)
      }
      aie.packet_rules(DMA : 0) {
        aie.rule(31, 9, %2)
      }
      aie.packet_rules(South : 5) {
        aie.rule(31, 17, %1)
      }
      aie.packet_rules(South : 4) {
        aie.rule(29, 17, %0)
      }
    }
    %shim_mux_5_0 = aie.shim_mux(%shim_noc_tile_5_0) {
      aie.connect<DMA : 1, North : 7>
      aie.connect<North : 3, DMA : 1>
    }
    %switchbox_5_0 = aie.switchbox(%shim_noc_tile_5_0) {
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.masterset(South : 3, %1)
      %3 = aie.masterset(North : 4, %0)
      aie.packet_rules(West : 0) {
        aie.rule(31, 9, %1)
      }
      aie.packet_rules(South : 7) {
        aie.rule(29, 17, %0)
      }
    }
    %switchbox_5_1 = aie.switchbox(%mem_tile_5_1) {
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.masterset(North : 1, %0)
      %3 = aie.masterset(North : 4, %1)
      aie.packet_rules(DMA : 4) {
        aie.rule(30, 30, %0)
      }
      aie.packet_rules(South : 4) {
        aie.rule(29, 17, %1)
      }
    }
    %switchbox_4_1 = aie.switchbox(%mem_tile_4_1) {
      aie.connect<DMA : 4, North : 5>
      aie.connect<DMA : 3, North : 1>
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.amsel<2> (0)
      %3 = aie.masterset(South : 0, %0)
      %4 = aie.masterset(South : 1, %1)
      %5 = aie.masterset(South : 3, %2)
      aie.packet_rules(North : 1) {
        aie.rule(31, 10, %1)
      }
      aie.packet_rules(North : 0) {
        aie.rule(31, 11, %0)
      }
      aie.packet_rules(North : 3) {
        aie.rule(31, 9, %2)
      }
    }
    %switchbox_4_2 = aie.switchbox(%tile_4_2) {
      aie.connect<South : 5, North : 5>
      aie.connect<East : 0, DMA : 1>
      aie.connect<South : 1, North : 4>
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.amsel<2> (0)
      %3 = aie.masterset(South : 0, %2)
      %4 = aie.masterset(South : 1, %0)
      %5 = aie.masterset(South : 3, %1)
      aie.packet_rules(North : 1) {
        aie.rule(31, 10, %0)
      }
      aie.packet_rules(North : 3) {
        aie.rule(31, 11, %2)
      }
      aie.packet_rules(North : 2) {
        aie.rule(31, 9, %1)
      }
    }
    %switchbox_4_3 = aie.switchbox(%tile_4_3) {
      aie.connect<South : 5, East : 1>
      aie.connect<South : 4, DMA : 0>
      aie.connect<South : 4, East : 2>
      %0 = aie.amsel<0> (0)
      %1 = aie.amsel<1> (0)
      %2 = aie.amsel<2> (0)
      %3 = aie.amsel<3> (0)
      %4 = aie.amsel<4> (0)
      %5 = aie.masterset(South : 1, %2)
      %6 = aie.masterset(South : 2, %3)
      %7 = aie.masterset(South : 3, %4)
      %8 = aie.masterset(North : 4, %1)
      %9 = aie.masterset(North : 5, %0)
      aie.packet_rules(North : 0) {
        aie.rule(31, 10, %2)
      }
      aie.packet_rules(North : 3) {
        aie.rule(31, 11, %4)
      }
      aie.packet_rules(North : 1) {
        aie.rule(31, 9, %3)
      }
      aie.packet_rules(East : 0) {
