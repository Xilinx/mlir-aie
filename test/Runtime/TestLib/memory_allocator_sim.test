//
// The AIESIM test_lib allocator (memory_allocator.cpp) hands out consecutive,
// 16-byte aligned physical addresses, including past 64 KiB. It is built from
// source against a stand-in xaiengine.h, so the test needs no aie-rt.
//
// RUN: mkdir -p memory_allocator_sim
// RUN: %host_clang -std=c++17 -D__AIESIM__ -I%S/Inputs -I%S/../../../runtime_lib/test_lib %S/memory_allocator_sim.cpp %S/../../../runtime_lib/test_lib/memory_allocator.cpp %host_link_flags -o memory_allocator_sim/test.exe
// RUN: ./memory_allocator_sim/test.exe | FileCheck %s

// CHECK: physical 0x0{{$}}
// CHECK: physical 0x10000{{$}}
// CHECK: physical 0x20000{{$}}
// CHECK: physical 0x20010{{$}}
