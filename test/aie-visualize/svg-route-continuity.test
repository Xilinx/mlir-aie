// RUN: not %python %S/Inputs/check-svg-route-continuity.py %S/Inputs/route-continuity.dot %S/Inputs/route-continuity.json %S/Inputs/route-continuity.svg 2>&1 | FileCheck %s
// RUN: %python %S/Inputs/check-svg-route-continuity.py %S/Inputs/route-continuity-good.dot %S/Inputs/route-continuity-good.json %S/Inputs/route-continuity-good.svg | FileCheck %s --check-prefix=GOOD

// CHECK: edges=4 format_defects=0 endpoint_defects=3 disconnected_segments=1 dangling_endpoints=1
// CHECK: disconnected-segments first=edge_gap_first:target second=edge_gap_second:source gap=6.000 groups=fate-target,src-2
// CHECK: dangling-endpoint edge=edge_dangling side=target
// GOOD: edges=1 format_defects=0 endpoint_defects=0 disconnected_segments=0 dangling_endpoints=0