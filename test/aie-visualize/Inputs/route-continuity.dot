digraph route_continuity {
  source [id="source"];
  target [id="target"];
  source -> target [id="edge_good", class="flow src-1 fate-target"];
  source -> target [id="edge_gap_first", class="flow src-2 fate-target"];
  source -> target [id="edge_gap_second", class="flow src-2 fate-target"];
  source -> target [id="edge_dangling", class="flow src-3 fate-target"];
}