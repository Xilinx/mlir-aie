// REQUIRES: peano
// RUN: rm -rf %t.d && mkdir -p %t.d
// RUN: %python %S/../aiecc/Inputs/iron_provenance.py generate %t.d/saved.mlir %t.d/expected.json
// RUN: aie-opt --canonicalize %t.d/saved.mlir -o %t.d/optimized.mlir
// RUN: aiecc --get-full-elf --get-elf --get-xclbin --full-elf-name=full.elf --elf-name=partial.elf --xclbin-name=design.xclbin --output-dir=%t.d/out --tmpdir=%t.d/work %t.d/optimized.mlir
// RUN: xclbinutil --input %t.d/out/design.xclbin --dump-section KEYVALUE_METADATA:JSON:%t.d/out/metadata.json
// RUN: %python %S/../aiecc/Inputs/iron_provenance.py check %t.d/out %t.d/expected.json
// RUN: %python %S/../aiecc/Inputs/iron_provenance.py validate %t.d/validation
