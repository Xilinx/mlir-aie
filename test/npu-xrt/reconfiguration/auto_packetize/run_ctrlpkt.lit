// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: rm -rf %t.d && mkdir -p %t.d
// RUN: cd %t.d
// RUN: %aiecc --get-full-elf --load-pdi-to-ctrl-pkt --get=input_physical.mlir %S/aie.mlir
// RUN: FileCheck %s < input_physical.mlir
// RUN: %host_clang -o test %S/test.cpp -std=c++17 %host_link_flags %xrt_flags
// RUN: %run_on_npu2% ./test

// CHECK-LABEL: aie.device(npu2) @cfg_add
// CHECK-DAG: aie.shim_dma_allocation @{{.+}}(%{{.+}}, MM2S, 0, <pkt_id = {{[0-9]+}}>)
// CHECK-DAG: aie.shim_dma_allocation @ctrlpkt_col0_mm2s_chan0(%{{.+}}, MM2S, 0)
// CHECK-LABEL: aie.device(npu2) @cfg_sub
// CHECK-DAG: aie.shim_dma_allocation @{{.+}}(%{{.+}}, MM2S, 0, <pkt_id = {{[0-9]+}}>)
// CHECK-DAG: aie.shim_dma_allocation @ctrlpkt_col0_mm2s_chan0(%{{.+}}, MM2S, 0)
