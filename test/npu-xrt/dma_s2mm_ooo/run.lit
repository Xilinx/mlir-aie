//
// Out-of-order S2MM merge across the matrix of receiver tile (compute core /
// memtile) and out-of-order channel count (1 / 2), swept over n senders, all
// with self-generating core senders and non-positional pinned bd_ids. The
// receiver is centered at col n//2 so packets funnel in from both sides; every
// config reaches the full-width n=8 except a core receiver with 2 channels,
// which tops out at n=7 (c*(n+1) = 2*8 = 16-BD core tile budget).
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile mem --channels 1 -n 2
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile mem --channels 1 -n 4
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile mem --channels 1 -n 8
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile mem --channels 2 -n 2
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile mem --channels 2 -n 4
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile mem --channels 2 -n 8
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile core --channels 1 -n 2
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile core --channels 1 -n 4
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile core --channels 1 -n 8
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile core --channels 2 -n 2
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile core --channels 2 -n 4
// RUN: %run_on_npu2% %python %S/dma_s2mm_ooo.py --recv-tile core --channels 2 -n 7
