//
// REQUIRES: ryzen_ai_npu1, peano
//
// mm.cc's get=true/put=false instantiation hits a PostRA pipeliner assert on
// current Peano (22.0.0.2026102001+4f5df13d) -- "Virtual register RegClass
// must be allocatable", from a dead VMOV_mv_scd (llvm-aie issue not yet
// filed). -aie-postpipeliner-vreg-mode=false routes the postpipeliner
// around the crashing virtual-register path and still builds correct
// cascade moves (vmov MCD/SCD); drop this once the pipeliner bug is fixed
// upstream.
//
// RUN: %PEANO_INSTALL_DIR/bin/clang --target=aie2-none-unknown-elf -O2 -Wno-macro-redefined -mllvm --aie-postpipeliner-vreg-mode=false -c %S/mm.cc -o ./mm.o
// RUN: g++-13 %S/test.cpp -o test.exe -std=c++23 -Wall %xrt_flags %host_link_flags %test_utils_flags
//
// RUN: %aiecc --get-xclbin --get-npu-insts --xclbin-name=aie2_plain.xclbin --npu-insts-name=insts2_plain.txt %S/aie_plainx4.mlir
// RUN: %run_on_npu1% ./test.exe -x aie2_plain.xclbin -k MLIR_AIE -i insts2_plain.txt --trace_sz 32768
//
// RUN: %aiecc --get-xclbin --get-npu-insts --xclbin-name=aie2_buffer.xclbin --npu-insts-name=insts2_buffer.txt %S/aie_bufferx4.mlir
// RUN: %run_on_npu1% ./test.exe -x aie2_buffer.xclbin -k MLIR_AIE -i insts2_buffer.txt --trace_sz 32768
//
// RUN: %aiecc --get-xclbin --get-npu-insts --xclbin-name=aie2_cascade.xclbin --npu-insts-name=insts2_cascade.txt %S/aie_cascadex4.mlir
// RUN: %run_on_npu1% ./test.exe -x aie2_cascade.xclbin -k MLIR_AIE -i insts2_cascade.txt --trace_sz 32768
