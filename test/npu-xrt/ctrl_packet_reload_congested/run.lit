// Loads a congested design by control packets. A router that moves the column
// control overlay's routes for it hangs the NPU.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: %aiecc --get-full-elf --load-pdi-to-ctrl-pkt --get-ctrlpkt --get=npu_insts_full_elf_{0}.bin %S/aie.mlir
// RUN: %host_clang -o test %S/test.cpp -std=c++17 %host_link_flags %xrt_flags
// RUN: %run_on_npu2% ./test
