//
// Loads a design by control packets whose routes detour through a column the
// column control overlay covers only part of.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: rm -rf %t.d && mkdir -p %t.d
// RUN: cd %t.d
// RUN: %aiecc --get-full-elf --load-pdi-to-ctrl-pkt --get-ctrlpkt --get=npu_insts_full_elf_{0}.bin %S/aie_detour.mlir
// RUN: %host_clang -o test %S/test.cpp -std=c++17 %host_link_flags %xrt_flags
// RUN: %run_on_npu2% ./test
