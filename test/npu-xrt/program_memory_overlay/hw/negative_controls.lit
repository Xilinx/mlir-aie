//
// The positive test has to be able to fail, or it proves nothing.
//
// Both controls here are produced by *not* writing a payload, and both are
// deterministic. Defects are injected when the design is generated rather than
// patched into a finished artifact: --skip-write names a phase, and there is no
// hunting for a payload in an instruction stream with a byte signature, which
// breaks whenever codegen shifts and can land on padding that never reaches the
// output.
//
// Why the design poisons every slot during setup, concretely. With the poison
// fill, skipping phase 0 reports "ran the poison fill". Without it, the same
// design produces "Kernel did not complete" -- the core jumps into whatever the
// *previous xclbin* left in program memory and hangs. npu-xrt runs serialized,
// so that outcome depends on which test ran last: a negative control that is
// sometimes a hang and sometimes a wrong answer is not a control at all.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -c %S/../resident.cc -o %t/resident.o
// RUN: %python %S/../pm.py emit --recipe one_slot --slot-ld %t/slot.ld --phases 0,1,2 --out %t/d1.mlir
// RUN: cd %t && %aiecc --tmpdir=%t/p1 --get-xclbin --xclbin-name=%t/p1.xclbin --get-npu-insts --npu-insts-name=%t/p1.bin %t/d1.mlir
// RUN: %python %S/../pm.py workload --tag 11 --size 0x400 --output %t/w0.o --workdir %t
// RUN: %python %S/../pm.py workload --tag 22 --size 0x400 --output %t/w1.o --workdir %t
// RUN: %python %S/../pm.py workload --tag 33 --size 0x400 --output %t/w2.o --workdir %t
// RUN: %python %S/../pm.py workload --tag 31661 --size 0x400 --output %t/poison.o --workdir %t
// RUN: %python %S/../pm.py link --object %t/w0.o --resident %t/p1 --recipe one_slot --output %t/ovl0.elf
// RUN: %python %S/../pm.py link --object %t/w1.o --resident %t/p1 --recipe one_slot --output %t/ovl1.elf
// RUN: %python %S/../pm.py link --object %t/w2.o --resident %t/p1 --recipe one_slot --output %t/ovl2.elf
// RUN: %python %S/../pm.py link --object %t/poison.o --resident %t/p1 --recipe one_slot --output %t/poison.elf
// RUN: %host_clang %S/../host.cpp -o %t/host.exe -std=c++17 -Wall %xrt_flags %host_link_flags %test_utils_flags
//
// Phase 0's payload is never written and nothing has been written before it, so
// the slot still holds the poison fill and the core runs that.
// RUN: %python %S/../pm.py emit --recipe one_slot --phases 0,1,2 --payload %t/ovl0.elf --payload %t/ovl1.elf --payload %t/ovl2.elf --poison %t/poison.elf --skip-write 0 --out %t/skip0.mlir
// RUN: cd %t && %aiecc --tmpdir=%t/s0 --get-xclbin --xclbin-name=%t/skip0.xclbin --get-npu-insts --npu-insts-name=%t/skip0.bin %t/skip0.mlir
// RUN: not %t/host.exe -x %t/skip0.xclbin -k MLIR_AIE -i %t/skip0.bin --tags 11,22,33 | FileCheck %s --check-prefix=POISON
// POISON: phase 0: ran the poison fill, so no overlay was written into the slot
// POISON: phase 1: overlay 22 ok
// POISON: phase 2: overlay 33 ok
// POISON: 1 phase(s) wrong
//
// Phase 1's payload is never written, but phase 0's still sits in the slot, so
// the core runs overlay 11 a second time. That the previous payload is what
// runs -- rather than nothing, or poison -- is the slot persisting across
// phases, which is the property that makes a swap a swap.
// RUN: %python %S/../pm.py emit --recipe one_slot --phases 0,1,2 --payload %t/ovl0.elf --payload %t/ovl1.elf --payload %t/ovl2.elf --poison %t/poison.elf --skip-write 1 --out %t/skip1.mlir
// RUN: cd %t && %aiecc --tmpdir=%t/s1 --get-xclbin --xclbin-name=%t/skip1.xclbin --get-npu-insts --npu-insts-name=%t/skip1.bin %t/skip1.mlir
// RUN: not %t/host.exe -x %t/skip1.xclbin -k MLIR_AIE -i %t/skip1.bin --tags 11,22,33 | FileCheck %s --check-prefix=STALE
// STALE: phase 0: overlay 11 ok
// STALE: phase 1: expected overlay 22, ran 11
// STALE: phase 2: overlay 33 ok
