//
// hw/one_slot.lit's exact scenario (three overlays, one slot, on hardware),
// built with the `aie.iron.overlay` API instead of pmlib's hand-driven
// pass1/link/pass2/check pipeline. Compare the RUN lines: one Python script
// call replaces pm.py emit / pm.py link (x3) / pm.py emit / pm.py check.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: %python %S/../iron_api_one_slot.py --tags 11,22,33 --out %t
//
// RUN: %host_clang %S/../host.cpp -o %t/host.exe -std=c++17 -Wall %xrt_flags %host_link_flags %test_utils_flags
// RUN: %t/host.exe -x %t/aie.xclbin -k MLIR_AIE -i %t/insts.bin --tags 11,22,33 | FileCheck %s
// CHECK: phase 0: overlay 11 ok
// CHECK: phase 1: overlay 22 ok
// CHECK: phase 2: overlay 33 ok
// CHECK: PASS!
