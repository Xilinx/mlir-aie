//
// Three overlays, one slot, on hardware.
//
// The headline case: which kernel a core runs is decided at run time by writing
// its program memory, and the core runs each of the three in turn.
//
// Each dummy overlay computes out[i] = in[i] + tag, so what ran in a phase is
// readable straight off the output -- no reference run to build or keep in
// step, and a phase that ran the wrong overlay reports which one it ran.
// Distinctness is by construction rather than checked: three different tags
// cannot produce identical rows, so this cannot go vacuous the way a workload
// with a constant output would.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -c %S/../resident.cc -o %t/resident.o
//
// Pass 1: the resident, which the overlays are then linked against.
// RUN: %python %S/../pm.py emit --recipe one_slot --slot-ld %t/slot.ld --phases 0,1,2 --out %t/d1.mlir
// RUN: cd %t && %aiecc --tmpdir=%t/p1 --get-xclbin --xclbin-name=%t/p1.xclbin --get-npu-insts --npu-insts-name=%t/p1.bin %t/d1.mlir
//
// RUN: %python %S/../pm.py workload --tag 11 --size 0x400 --output %t/w0.o --workdir %t
// RUN: %python %S/../pm.py workload --tag 22 --size 0x400 --output %t/w1.o --workdir %t
// RUN: %python %S/../pm.py workload --tag 33 --size 0x400 --output %t/w2.o --workdir %t
// RUN: %python %S/../pm.py workload --tag 31661 --size 0x400 --output %t/poison.o --workdir %t
// RUN: %python %S/../pm.py link --object %t/w0.o --resident %t/p1 --recipe one_slot --output %t/ovl0.elf
// RUN: %python %S/../pm.py link --object %t/w1.o --resident %t/p1 --recipe one_slot --output %t/ovl1.elf
// RUN: %python %S/../pm.py link --object %t/w2.o --resident %t/p1 --recipe one_slot --output %t/ovl2.elf
// RUN: %python %S/../pm.py link --object %t/poison.o --resident %t/p1 --recipe one_slot --output %t/poison.elf
//
// Pass 2 recompiles the core, so the resident the overlays were linked against
// has to be the one that got built -- every overlay holds pass 1's addresses.
// RUN: %python %S/../pm.py emit --recipe one_slot --phases 0,1,2 --payload %t/ovl0.elf --payload %t/ovl1.elf --payload %t/ovl2.elf --poison %t/poison.elf --out %t/d2.mlir
// RUN: cd %t && %aiecc --tmpdir=%t/p2 --get-xclbin --xclbin-name=%t/aie.xclbin --get-npu-insts --npu-insts-name=%t/insts.bin %t/d2.mlir
// RUN: %python %S/../pm.py check %t/p1 %t/p2
//
// RUN: %host_clang %S/../host.cpp -o %t/host.exe -std=c++17 -Wall %xrt_flags %host_link_flags %test_utils_flags
// RUN: %t/host.exe -x %t/aie.xclbin -k MLIR_AIE -i %t/insts.bin --tags 11,22,33 | FileCheck %s
// CHECK: phase 0: overlay 11 ok
// CHECK: phase 1: overlay 22 ok
// CHECK: phase 2: overlay 33 ok
// CHECK: PASS!
