//
// Three real aie_kernels swapped through one slot, checked numerically.
//
// The rest of the hardware tier runs generated workloads: branch-free padding
// plus a loop, sized exactly, distinct by construction. That makes those tests
// precise, and it also means they exercise very little of what a kernel
// actually does. These are ordinary library kernels -- they branch, they call,
// they use the vector unit, their .text is whatever it is, and they work in
// bfloat16 rather than int32. If the mechanism only worked for simple code,
// this is the test that would show it.
//
// Checked against float references to a tolerance, because the kernels use
// tanh and exp approximations. That is a different kind of verification from
// the rest of the suite, which recovers a tag arithmetically -- and it is worth
// having one of each: a tag proves which overlay ran, a numeric check proves it
// ran correctly.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -c %S/../resident.cc -o %t/resident.o
// RUN: %python %S/../pm.py emit --recipe one_slot --dtype bf16 --n-elems 1024 --slot-ld %t/slot.ld --phases 0,1,2 --out %t/d1.mlir
// RUN: cd %t && %aiecc --tmpdir=%t/p1 --get-xclbin --xclbin-name=%t/p1.xclbin --get-npu-insts --npu-insts-name=%t/p1.bin %t/d1.mlir
//
// The kernels, and one wrapper each giving them the entry signature.
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -std=c++20 -DNDEBUG -D__AIE_API_AIE_ADF_HPP__ -I %S/../../../../include -I %S/../../../../third_party/aie_api/include -I %S/../../../../aie_kernels -c %S/../../../../aie_kernels/aie2p/silu.cc -o %t/silu.o
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -std=c++20 -DNDEBUG -D__AIE_API_AIE_ADF_HPP__ -I %S/../../../../include -I %S/../../../../third_party/aie_api/include -I %S/../../../../aie_kernels -c %S/../../../../aie_kernels/aie2p/gelu.cc -o %t/gelu.o
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -std=c++20 -DNDEBUG -D__AIE_API_AIE_ADF_HPP__ -I %S/../../../../include -I %S/../../../../third_party/aie_api/include -I %S/../../../../aie_kernels -c %S/../../../../aie_kernels/aie2p/softmax.cc -o %t/softmax.o
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -std=c++20 -DNDEBUG -D__AIE_API_AIE_ADF_HPP__ -I %S/../../../../include -I %S/../../../../third_party/aie_api/include -I %S/../../../../aie_kernels -DOVL_ID=0 -c %S/../kernels.cc -o %t/k0.o
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -std=c++20 -DNDEBUG -D__AIE_API_AIE_ADF_HPP__ -I %S/../../../../include -I %S/../../../../third_party/aie_api/include -I %S/../../../../aie_kernels -DOVL_ID=1 -c %S/../kernels.cc -o %t/k1.o
// RUN: %PEANO_INSTALL_DIR/bin/clang++ --target=aie2p-none-unknown-elf -O2 -std=c++20 -DNDEBUG -D__AIE_API_AIE_ADF_HPP__ -I %S/../../../../include -I %S/../../../../third_party/aie_api/include -I %S/../../../../aie_kernels -DOVL_ID=2 -c %S/../kernels.cc -o %t/k2.o
//
// RUN: %python %S/../pm.py link --object %t/k0.o --object %t/silu.o --resident %t/p1 --recipe one_slot --output %t/ovl0.elf
// RUN: %python %S/../pm.py link --object %t/k1.o --object %t/gelu.o --resident %t/p1 --recipe one_slot --output %t/ovl1.elf
// RUN: %python %S/../pm.py link --object %t/k2.o --object %t/softmax.o --resident %t/p1 --recipe one_slot --output %t/ovl2.elf
//
// The size table, printed but not gated: these are real kernels and a codegen
// improvement that shrinks one should not fail a correctness test. Only
// hw/capacity.lit asserts on the total, with synthetic workloads whose sizes
// are stable by construction.
// RUN: %python %S/../pm.py sizes --resident %t/p1 --recipe one_slot --overlays %t/ovl0.elf %t/ovl1.elf %t/ovl2.elf
//
// RUN: %python %S/../pm.py emit --recipe one_slot --dtype bf16 --n-elems 1024 --phases 0,1,2 --payload %t/ovl0.elf --payload %t/ovl1.elf --payload %t/ovl2.elf --out %t/d2.mlir
// RUN: cd %t && %aiecc --tmpdir=%t/p2 --get-xclbin --xclbin-name=%t/aie.xclbin --get-npu-insts --npu-insts-name=%t/insts.bin %t/d2.mlir
// RUN: %python %S/../pm.py check %t/p1 %t/p2 --overlays %t/ovl0.elf %t/ovl1.elf %t/ovl2.elf
// RUN: %host_clang %S/../test.cpp -o %t/test.exe -std=c++17 -Wall %xrt_flags %host_link_flags %test_utils_flags
// RUN: %t/test.exe -x %t/aie.xclbin -k MLIR_AIE -i %t/insts.bin | FileCheck %s
// CHECK: PASS!
