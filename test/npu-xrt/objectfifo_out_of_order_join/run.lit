//
// Several cores' objects joined on another core over its one S2MM channel,
// out of order: each packet names the segment of the joined buffer it lands
// in, whichever sender's arrives first.
//
// REQUIRES: ryzen_ai_npu2, peano, xrt_python_bindings
//
// RUN: %run_on_npu2% %python %S/test.py --senders 2
// RUN: %run_on_npu2% %python %S/test.py --senders 3
