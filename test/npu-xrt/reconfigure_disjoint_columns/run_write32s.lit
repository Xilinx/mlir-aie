// REQUIRES: ryzen_ai_npu2, peano
//
// The empty-device reset: the control this directory's register-reset test is
// read against.
//
// RUN: rm -rf %t.d && mkdir -p %t.d
// RUN: cd %t.d
// RUN: %aiecc -v --get-full-elf --expand-load-pdis %S/aie.mlir
// RUN: %host_clang -o test %S/test.cpp -std=c++17 %host_link_flags %xrt_flags
// RUN: ./test 32
