//
// A core's ObjectFifo back to itself through its tile's DMAs, acquiring more
// to consume than to produce. The producing end's pool holds only what the
// core acquires to produce plus the object in flight.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: aie-opt --aie-objectfifo-split %S/aie.mlir | FileCheck %s
// RUN: %aiecc --get-xclbin --get-npu-insts --xclbin-name=aie.xclbin --npu-insts-name=insts.bin %S/aie.mlir
// RUN: %host_clang %S/test.cpp -o test.exe -std=c++17 -Wall %xrt_flags %host_link_flags %test_utils_flags
// RUN: %run_on_npu2% ./test.exe -x aie.xclbin -k MLIR_AIE -i insts.bin

// CHECK: aie.objectfifo.pool @loop__pool(%{{.*}}) {depth = 2 : i32
// CHECK: aie.objectfifo.pool @loop__cons__pool(%{{.*}}) {depth = 4 : i32
