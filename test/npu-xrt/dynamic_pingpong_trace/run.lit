//
// REQUIRES: ryzen_ai, peano
//
// Dynamic ping-pong passthrough with hardware tracing via a SEPARATE trace
// buffer -- the correct trace path for a runtime-sized (dynamic) sequence.
// -aie-insert-trace-flows appends a dedicated i8 trace-buffer argument (default
// reuse_output_buffer=false), independent of the runtime %n, so the trace lands
// at its own offset 0 rather than past a max-sized output. One xclbin serves any
// n; the host reads the trace buffer back and checks it is non-empty while the
// data output still matches the golden.
//
// aiecc builds both the xclbin and the parameterized instruction builder.
//
// RUN: mkdir -p %t.prj
// RUN: cp %S/aie.mlir aie_arch.mlir
// RUN: %run_on_npu1% sed 's/NPUDEVICE/npu1_1col/g' -i aie_arch.mlir
// RUN: %run_on_npu2% sed 's/NPUDEVICE/npu2_1col/g' -i aie_arch.mlir
// RUN: %aiecc --get-xclbin --get-npu-cpp --npu-cpp-name=%t.gen.h \
// RUN:   --output-dir=%t.prj \
// RUN:   --xclbin-name=%t.xclbin --tmpdir=%t.prj aie_arch.mlir
//
// RUN: %host_clang %S/test.cpp -o %t.exe -std=c++17 -Wall \
// RUN:   -DGEN_HDR='"%t.gen.h"' -DXCLBIN='std::string("%/t.xclbin")' \
// RUN:   -I%S/../../../include %xrt_flags %host_link_flags %test_utils_flags
//
// The runtime tile count is the host argument; exercise a couple of values.
// RUN: %run_on_npu1% %t.exe 2
// RUN: %run_on_npu2% %t.exe 2
// RUN: %run_on_npu1% %t.exe 8
// RUN: %run_on_npu2% %t.exe 8
