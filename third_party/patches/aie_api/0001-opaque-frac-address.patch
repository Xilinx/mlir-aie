diff --git a/include/aie_api/detail/ld_st.hpp b/include/aie_api/detail/ld_st.hpp
index a325c7c..ae203ac 100644
--- a/include/aie_api/detail/ld_st.hpp
+++ b/include/aie_api/detail/ld_st.hpp
@@ -84,6 +84,25 @@ constexpr T *floor_ptr(T *ptr)
     return floor_ptr<native_vector_length_v<T>, T>(ptr);
 }
 
+// The address of ptr, hidden from the optimizer. The unaligned accessors derive
+// a realigning shift from `address & mask` but load through the unfloored
+// pointer (the hardware truncates it), so a compiler that reads the alignment
+// off those loads folds the shift to 0. Peano on LLVM from 2025-12-12 (which
+// has the gcc_struct attribute on Itanium targets) does; the annotation is
+// dropped by the backend and leaves older compilers' code unchanged.
+template <typename T>
+__aie_inline
+uintptr_t opaque_addr(T *ptr)
+{
+    uintptr_t addr = (uintptr_t)ptr;
+#if AIE_API_NATIVE == 0 && defined(__has_attribute)
+#if __has_attribute(gcc_struct)
+    addr = __builtin_annotation(addr, "aie_api.opaque_addr");
+#endif
+#endif
+    return addr;
+}
+
 }
 
 template <typename T, unsigned Elems, aie_dm_resource Resource>
