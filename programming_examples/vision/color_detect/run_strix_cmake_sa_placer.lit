//
// Build+run via CMake + ctest (no make; works on Windows). Mirrors
// run_strix_makefile_sa_placer.lit: the same design placed with the
// simulated-annealing placer instead of the default one.
//
// Pinned to npu2 rather than %aie_cmake_device% because that makefile lit is
// npu2-only; the placer choice itself is device-independent.
//
// REQUIRES: ryzen_ai_npu2, peano, opencv, cmake_examples
//
// RUN: cmake -G Ninja -S %S -B %t.cmake -DAIE_DEVICE=npu2 -DUSE_SA_PLACER=ON -DPython3_EXECUTABLE=%python
// RUN: cmake --build %t.cmake
// RUN: ctest --test-dir %t.cmake --output-on-failure --no-tests=error
