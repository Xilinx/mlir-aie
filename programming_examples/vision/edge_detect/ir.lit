// RUN: %python %S/edge_detect.py --dev npu --emit-mlir -W 128 -H 4 > %t.npu.mlir
// RUN: FileCheck %s --implicit-check-not=OF_local < %t.npu.mlir
// RUN: %python %S/edge_detect.py --dev npu2 --emit-mlir -W 128 -H 4 > %t.npu2.mlir
// RUN: FileCheck %s --implicit-check-not=OF_local < %t.npu2.mlir
//
// The two kernels in the final Worker share one local scratch buffer.
// CHECK: %[[RGBA:[a-zA-Z0-9_]+]] = aie.buffer{{.*}}sym_name = "rgba_line"
// CHECK-SAME: memref<512xui8>
// CHECK: call @{{"?[0-9a-f]{8}_gray2rgbaLine"?}}({{.*}}, %[[RGBA]],
// CHECK: call @{{"?[0-9a-f]{8}_addWeightedLine"?}}(%[[RGBA]],
