//
// The prefill's GEMM array (aie2_prefill.py) at 2 layers on NPU2: one
// projection of 64 rows a layer from the decode's weight blob, every output
// row bit-exact to the numpy oracle (llama_oracle.Layer.project), with two
// epilogue cores per GEMM core and with one. --synthetic-weights swaps the
// layers' weights for seeded ones in the same layout.
//
// REQUIRES: ryzen_ai_npu2, peano, xrt_python_bindings
//
// RUN: %run_on_npu2% %python %S/test_prefill_gemm.py --synthetic-weights --proj q --n-layers 2 --iters 0 | FileCheck --check-prefix=Q %s
// Q: q x 2 layers, 64 rows each: 128/128 rows bit-exact: PASS
//
// RUN: %run_on_npu2% %python %S/test_prefill_gemm.py --synthetic-weights --proj k --n-layers 2 --epi-cores 1 --iters 0 | FileCheck --check-prefix=K %s
// K: k x 2 layers, 64 rows each: 128/128 rows bit-exact: PASS
