//
// One multi-head GQA decoder layer on NPU2 against the numpy oracle, on a
// random fixture (no model weights needed). Builds into the test's own dir.
//
// REQUIRES: ryzen_ai_npu2, peano
// REQUIRES: makefile_examples
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: make -f %S/Makefile BUILD=%t layer_mh
// RUN: %run_on_npu2% make -f %S/Makefile BUILD=%t run_layer_mh | FileCheck %s
// CHECK: layer_mh: 4/4 seeds PASS
