//
// A 2-layer decode chain on NPU2 against the numpy oracle, on a random
// fixture (no model weights needed). The test compiles the design with
// @iron.jit.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: env LLAMA_CHAIN_N=2 %run_on_npu2% %python %S/test_chain_mh.py | FileCheck %s
// CHECK: chain_mh: 4/4 seeds PASS
