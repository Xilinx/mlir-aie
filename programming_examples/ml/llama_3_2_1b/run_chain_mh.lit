//
// A 2-layer decode chain on NPU2 against the numpy oracle, on a random
// fixture (no model weights needed). Builds into the test's own dir.
//
// REQUIRES: ryzen_ai_npu2, peano
// REQUIRES: makefile_examples
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: make -f %S/Makefile BUILD=%t CHAIN_MH_N=2 chain_mh
// RUN: %run_on_npu2% make -f %S/Makefile BUILD=%t CHAIN_MH_N=2 run_chain_mh | FileCheck %s
// CHECK: chain_mh: 4/4 seeds PASS
