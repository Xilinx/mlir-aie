//
// Build+run via CMake + ctest (no make; works on Windows). Mirrors run.lit's
// two variants: single-core and the 32-core `multi=1`. Both are aie2p only, so
// this is pinned to npu2 rather than using %aie_cmake_device%.
// add_aie_run_test's ctest already wraps run_on_npu.py, so ctest runs directly.
//
// REQUIRES: ryzen_ai_npu2, peano, torch, cmake_examples
//
// RUN: cmake -G Ninja -S %S -B %t.single -DAIE_DEVICE=npu2 -DPython3_EXECUTABLE=%python
// RUN: cmake --build %t.single
// RUN: ctest --test-dir %t.single --output-on-failure --no-tests=error
//
// RUN: cmake -G Ninja -S %S -B %t.multi -DAIE_DEVICE=npu2 -DMULTI=ON -DPython3_EXECUTABLE=%python
// RUN: cmake --build %t.multi
// RUN: ctest --test-dir %t.multi --output-on-failure --no-tests=error
