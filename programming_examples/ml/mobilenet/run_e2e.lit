//
// Per-block + per-chain IRON e2e on the NPU2. test_e2e.py compiles each design
// with @iron.jit, runs it for three launches on one hardware context, and
// compares the last output against the matching brevitas golden_output*.txt.
// Every target is exact except the regular chain (atol=14, #3009).
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e block bn1 -w 1 -i 2 | FileCheck --check-prefix=BN1 %s
// BN1: PASS_E2E block:bn1
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e block bn2 -w 1 -i 2 | FileCheck --check-prefix=BN2 %s
// BN2: PASS_E2E block:bn2
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e block bn3 -w 1 -i 2 | FileCheck --check-prefix=BN3 %s
// BN3: PASS_E2E block:bn3
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e block bn6 -w 1 -i 2 | FileCheck --check-prefix=BN6 %s
// BN6: PASS_E2E block:bn6
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e block bn7 -w 1 -i 2 | FileCheck --check-prefix=BN7 %s
// BN7: PASS_E2E block:bn7
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e block bn8 -w 1 -i 2 | FileCheck --check-prefix=BN8 %s
// BN8: PASS_E2E block:bn8
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e chain regular -w 1 -i 2 | FileCheck --check-prefix=REG %s
// REG: PASS_E2E chain:regular
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e chain pipeline -w 1 -i 2 | FileCheck --check-prefix=PIPE %s
// PIPE: PASS_E2E chain:pipeline
//
// RUN: cd %S/.. && %run_on_npu2% %python -m mobilenet.test_e2e chain cascade -w 1 -i 2 | FileCheck --check-prefix=CAS %s
// CAS: PASS_E2E chain:cascade
