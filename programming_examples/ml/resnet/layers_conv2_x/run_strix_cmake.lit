//
// Build+run via CMake + ctest (no make; works on Windows). Mirrors
// run_strix_makefile.lit, including its expected failure.
//
// Known-failing numerical check on the NPU. Silently skipped on main (the torch
// feature was off), so mark as an expected failure now that it runs.
// XFAIL: *
//
// REQUIRES: ryzen_ai_npu2, peano, torch, cmake_examples
//
// RUN: cmake -G Ninja -S %S -B %t.cmake -DAIE_DEVICE=npu2 -DPython3_EXECUTABLE=%python
// RUN: cmake --build %t.cmake
// RUN: ctest --test-dir %t.cmake --output-on-failure --no-tests=error
