//
// Build+run via CMake + ctest (no make; works on Windows). Mirrors
// run_makefile.lit.
// add_aie_run_test's ctest already wraps run_on_npu.py, so ctest runs directly.
//
// Not %aie_cmake_device%: unlike its siblings the two makefile lits here are
// not the same test on two devices -- the npu2 one is XFAIL. They stay two
// lits so that stays expressible. See run_strix_cmake.lit.
//
// REQUIRES: ryzen_ai_npu1, peano, torch, cmake_examples
//
// RUN: cmake -G Ninja -S %S -B %t.cmake -DAIE_DEVICE=npu -DPython3_EXECUTABLE=%python
// RUN: cmake --build %t.cmake
// RUN: ctest --test-dir %t.cmake --output-on-failure --no-tests=error
