//
// Build+run via CMake + ctest (no make; works on Windows). Mirrors
// run_phoenix_group0_trace.lit, including its expected failure.
//
// group0 routes the trace of two cores into one shim channel, and the capture
// holds no data: parse.py reports "No valid trace data found". group2 traces
// one core and its trace run passes, so the shared channel is the open problem.
// XFAIL: *
//
// REQUIRES: ryzen_ai_npu1, peano, torch, cmake_examples
//
// RUN: cmake -G Ninja -S %S -B %t.cmake -DAIE_DEVICE=npu -DGROUP=group0 -DTRACE_SIZE=16384 -DPython3_EXECUTABLE=%python
// RUN: cmake --build %t.cmake
// RUN: ctest --test-dir %t.cmake --output-on-failure --no-tests=error
//
// The post-processing the Makefile's trace_py recipe does after the run, and
// the step that fails: parse.py exits nonzero on an empty capture.
// RUN: %python %S/../../../python/utils/trace/parse.py --input %t.cmake/log/trace_magika.txt --mlir %t.cmake/input_with_addresses.mlir --output %t.cmake/trace_group0.json
// RUN: %python %S/../../../python/utils/trace/get_trace_summary.py --input %t.cmake/trace_group0.json
