//
// Build+run via CMake + ctest (no make; works on Windows).
// add_aie_run_test's ctest already wraps run_on_npu.py, so ctest runs directly.
//
// Unlike its siblings this stays pinned to npu, matching the single
// run_makefile.lit: cascade has no npu2 variant to reach parity with.
//
// REQUIRES: ryzen_ai_npu1, peano, cmake_examples
//
// RUN: cmake -G Ninja -S %S/../.. -B %t.cmake -DAIE_DEVICE=npu -DTARGET_NAME=cascade -Dsubdir=cascade -DPython3_EXECUTABLE=%python
// RUN: cmake --build %t.cmake
// RUN: ctest --test-dir %t.cmake --output-on-failure --no-tests=error
