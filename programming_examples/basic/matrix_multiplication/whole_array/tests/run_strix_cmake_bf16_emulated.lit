//
// Build+run via CMake + ctest (no make; works on Windows).
// add_aie_run_test's ctest already wraps run_on_npu.py, so ctest runs directly.
//
// REQUIRES: ryzen_ai_npu2, peano, cmake_examples
//
// RUN: cmake -G Ninja -S %S/../.. -B %t.cmake -DAIE_DEVICE=npu2 -DTARGET_NAME=whole_array -Dsubdir=whole_array -DDTYPE_IN=bf16 -DDTYPE_OUT=bf16 -DTILE_M=32 -DTILE_K=32 -DTILE_N=32 -DM=512 -DK=512 -DN=512 -DEMULATE_BF16_MMUL_WITH_BFP16=1
// RUN: cmake --build %t.cmake
// RUN: ctest --test-dir %t.cmake --output-on-failure --no-tests=error
