//
// Build+run via CMake + ctest (no make; works on Windows).
// add_aie_run_test's ctest already wraps run_on_npu.py, so ctest runs directly.
// The CMake project is the shared parent dir; -DDESIGN_DIR/-DVARIANT select
// this sweep point (mirrors run_makefile_row_wise.lit).
//
// REQUIRES: ryzen_ai, peano, cmake_examples
//
// RUN: cmake -G Ninja -S %S/.. -B %t.cmake -DAIE_DEVICE=%aie_cmake_device% -DTARGET_NAME=row_wise_vector_reduce_max -DDESIGN_DIR=multi_column_designs -DVARIANT=row_wise -DAIE_DTYPE=i32
// RUN: cmake --build %t.cmake
// RUN: ctest --test-dir %t.cmake --output-on-failure --no-tests=error
