//
// static_dma.py and copy_buffer.py address DDR themselves, so there is no host
// buffer to hand them and nothing to verify. They need no device, so their
// checks run wherever the examples are built.
//
// RUN: %python %S/static_dma.py | FileCheck %s
//
// One aie.external_buffer per DDR end, at the address the design names.
// CHECK: aie.external_buffer {address = 2147483648 : i64, sym_name = "devmem"}
// CHECK: aie.external_buffer {address = 2148532224 : i64, sym_name = "result"}
//
// The tile's chains loop, paced by the lock pair.
// CHECK: aie.mem
// CHECK:   aie.dma_start(S2MM, 0, ^[[IN:.*]], ^{{.*}})
// CHECK:   ^[[IN]]:
// CHECK:     aie.use_lock(%buf_free, AcquireGreaterEqual
// CHECK:     aie.use_lock(%buf_full, Release
// CHECK:     aie.next_bd ^[[IN]]
//
// The shim's take no locks, so their chains end: the slice moves once, as one
// descriptor, with the offset and steps the slice describes.
// CHECK: aie.shim_dma
// CHECK:   aie.dma_start(MM2S, 0, ^{{.*}}, ^{{.*}})
// CHECK:   aie.dma_bd(%devmem
// CHECK-SAME: offset = 512 len = 32768 sizes = [8, 8, 512] strides = [16384, 1024, 1]
// CHECK-NOT:  iteration
//
// Nothing is dispatched.
// CHECK: aie.runtime_sequence()
//
// copy_buffer.py derives the same wiring from one call per transfer, so it has
// to arrive at the same design -- not merely a working one.
// RUN: diff <(%python %S/static_dma.py) <(%python %S/copy_buffer.py)
