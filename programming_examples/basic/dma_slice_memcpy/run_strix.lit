// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: %run_on_npu2% %python %S/tile_dma.py -d npu2
// RUN: %run_on_npu2% %python %S/objectfifo.py -d npu2
//
// static_dma.py addresses DDR itself, so there is no host buffer to hand it and
// nothing to verify; check that it still builds legal MLIR.
// RUN: %python %S/static_dma.py | FileCheck %s
//
// CHECK: aie.external_buffer {address = 2147483648 : i64, sym_name = "device_memory_devmem"}
// CHECK: aie.shim_dma
// CHECK:   aie.dma_start(MM2S, 0
// CHECK:   aie.dma_bd(%device_memory_devmem
// CHECK-SAME: iteration = #aie.bd_iteration<size = 8, stride = 131072, current = 0>
// CHECK: aie.runtime_sequence()
