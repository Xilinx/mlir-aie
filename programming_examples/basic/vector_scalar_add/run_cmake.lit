//
// Make-free build+run via CMake + ctest (works on Windows; no GNU make).
// The ctest registered by add_aie_run_test already runs the host exe on the NPU
// through run_on_npu.py, so ctest is invoked directly (not wrapped again).
//
// REQUIRES: ryzen_ai_npu1, peano, cmake_examples
//
// RUN: cmake -G Ninja -S %S -B %t.cmake -DAIE_DEVICE=npu -DTARGET_NAME=vector_scalar_add
// RUN: cmake --build %t.cmake
// RUN: ctest --test-dir %t.cmake --output-on-failure
